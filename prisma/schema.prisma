model StockTransfer {
  id             String              @id @default(uuid()) @db.Uuid
  tenantId       String              @map("tenant_id") @db.Uuid
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transferNumber String              @map("transfer_number")
  sourceStoreId  String              @map("source_store_id") @db.Uuid
  sourceStore    Store               @relation("TransfersSent", fields: [tenantId, sourceStoreId], references: [tenantId, id], onDelete: Restrict)
  destStoreId    String              @map("dest_store_id") @db.Uuid
  destStore      Store               @relation("TransfersReceived", fields: [tenantId, destStoreId], references: [tenantId, id], onDelete: Restrict)
  status         StockTransferStatus @default(draft)
  notes          String?
  shippedAt      DateTime?           @map("shipped_at") @db.Timestamptz(6)
  receivedAt     DateTime?           @map("received_at") @db.Timestamptz(6)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  items StockTransferItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, transferNumber])
  @@index([tenantId, sourceStoreId])
  @@index([tenantId, destStoreId])
  @@map("stock_transfers")
}

model StockTransferItem {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transferId  String        @map("transfer_id") @db.Uuid
  transfer    StockTransfer @relation(fields: [tenantId, transferId], references: [tenantId, id], onDelete: Cascade)
  productId   String        @map("product_id") @db.Uuid
  product     Product       @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  quantity    Decimal       @db.Decimal(12, 3)
  receivedQty Decimal?      @map("received_qty") @db.Decimal(12, 3)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, id])
  @@index([tenantId, transferId])
  @@map("stock_transfer_items")
}

model InvoiceScanJob {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplierId      String?           @map("supplier_id") @db.Uuid
  supplier        Supplier?         @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict)
  purchaseOrderId String?           @map("purchase_order_id") @db.Uuid
  purchaseOrder   PurchaseOrder?    @relation(fields: [tenantId, purchaseOrderId], references: [tenantId, id], onDelete: Restrict)
  imageUrl        String            @map("image_url")
  status          InvoiceScanStatus @default(pending)
  extractedData   Json?             @map("extracted_data")
  confidenceScore Decimal?          @map("confidence_score") @db.Decimal(5, 2)
  errorMessage    String?           @map("error_message")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("invoice_scan_jobs")
}

model ZReport {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storeId           String    @map("store_id") @db.Uuid
  store             Store     @relation(fields: [tenantId, storeId], references: [tenantId, id], onDelete: Restrict)
  reportNumber      String    @map("report_number")
  reportDate        DateTime  @map("report_date") @db.Date
  openingBalance    Decimal   @default(0.00) @map("opening_balance") @db.Decimal(12, 2)
  cashSales         Decimal   @default(0.00) @map("cash_sales") @db.Decimal(12, 2)
  cardSales         Decimal   @default(0.00) @map("card_sales") @db.Decimal(12, 2)
  creditSales       Decimal   @default(0.00) @map("credit_sales") @db.Decimal(12, 2)
  totalSales        Decimal   @map("total_sales") @db.Decimal(12, 2)
  totalTax          Decimal   @map("total_tax") @db.Decimal(12, 2)
  transactionsCount Int       @default(0) @map("transactions_count")
  closingBalance    Decimal   @map("closing_balance") @db.Decimal(12, 2)
  cashDifference    Decimal   @default(0.00) @map("cash_difference") @db.Decimal(12, 2)
  sentViaWhatsapp   Boolean   @default(false) @map("sent_via_whatsapp")
  whatsappSentAt    DateTime? @map("whatsapp_sent_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, id])
  @@unique([tenantId, storeId, reportDate])
  @@index([tenantId, reportDate])
  @@map("z_reports")
}

model StockPrediction {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storeId             String    @map("store_id") @db.Uuid
  store               Store     @relation(fields: [tenantId, storeId], references: [tenantId, id], onDelete: Restrict)
  productId           String    @map("product_id") @db.Uuid
  product             Product   @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)
  dailyVelocity       Decimal   @map("daily_velocity") @db.Decimal(12, 3)
  daysRemaining       Int       @map("days_remaining")
  predictedStockoutAt DateTime? @map("predicted_stockout_at") @db.Timestamptz(6)
  suggestedReorderQty Decimal   @map("suggested_reorder_qty") @db.Decimal(12, 3)
  confidenceScore     Decimal   @map("confidence_score") @db.Decimal(5, 2)
  calculatedAt        DateTime  @default(now()) @map("calculated_at") @db.Timestamptz(6)

  @@unique([tenantId, id])
  @@unique([tenantId, storeId, productId])
  @@index([tenantId, daysRemaining])
  @@map("stock_predictions")
}

model SystemSetting {
