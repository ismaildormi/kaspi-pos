  providerName String   @map("provider_name")
  apiKey       String   @map("api_key")
  baseUrl      String?  @map("base_url")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([providerName])
  @@map("system_settings")
}

model TenantSettings {
  id                      String   @id @default(uuid()) @db.Uuid
  tenantId                String   @unique @map("tenant_id") @db.Uuid
  shopName                String?  @map("shop_name")
  address                 String?
  ice                     String?
  taxId                   String?  @map("tax_id")
  rcNumber                String?  @map("rc_number")
  phone                   String?
  logoUrl                 String?  @map("logo_url")
  receiptHeader           String?  @map("receipt_header")
  receiptFooter           String?  @map("receipt_footer")
  whatsappReportNumber    String?  @map("whatsapp_report_number")
  whatsappReportHour      String?  @default("21:00") @map("whatsapp_report_hour")
  storeTimezone           String?  @default("Africa/Casablanca") @map("store_timezone")
  ecommerceSyncConfig     Json?    @map("ecommerce_sync_config")
  isWhatsappReportsActive Boolean  @default(true) @map("is_whatsapp_reports_active")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

