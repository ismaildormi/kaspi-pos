  storeId       String      @map("store_id") @db.Uuid
  store         Store       @relation(fields: [tenantId, storeId], references: [tenantId, id], onDelete: Restrict)
  tableNumber   String      @map("table_number")
  name          String?
  capacity      Int         @default(4)
  status        TableStatus @default(available)
  currentSaleId String?     @map("current_sale_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  sales          Sale[]
  kitchenTickets KitchenTicket[]

  @@unique([tenantId, id])
  @@unique([tenantId, storeId, tableNumber])
  @@index([tenantId, storeId, status])
  @@map("dining_tables")
}

model KitchenTicket {
  id           String              @id @default(uuid()) @db.Uuid
  tenantId     String              @map("tenant_id") @db.Uuid
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storeId      String              @map("store_id") @db.Uuid
  store        Store               @relation(fields: [tenantId, storeId], references: [tenantId, id], onDelete: Restrict)
  tableId      String?             @map("table_id") @db.Uuid
  table        DiningTable?        @relation(fields: [tenantId, tableId], references: [tenantId, id], onDelete: Restrict)
  saleId       String?             @map("sale_id") @db.Uuid
  sale         Sale?               @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: Restrict)
  ticketNumber String              @map("ticket_number")
  status       KitchenTicketStatus @default(new)
  notes        String?
  sentAt       DateTime            @default(now()) @map("sent_at") @db.Timestamptz(6)
  readyAt      DateTime?           @map("ready_at") @db.Timestamptz(6)
  servedAt     DateTime?           @map("served_at") @db.Timestamptz(6)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  items KitchenTicketItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, storeId, ticketNumber])
  @@index([tenantId, storeId, status])
  @@map("kitchen_tickets")
}

model KitchenTicketItem {
  id          String            @id @default(uuid()) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticketId    String            @map("ticket_id") @db.Uuid
  ticket      KitchenTicket     @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Cascade)
  productId   String?           @map("product_id") @db.Uuid
  product     Product?          @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  productName String            @map("product_name")
  quantity    Decimal           @db.Decimal(12, 3)
  status      KitchenItemStatus @default(pending)
  notes       String?
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, id])
  @@index([tenantId, ticketId])
  @@map("kitchen_ticket_items")
}

