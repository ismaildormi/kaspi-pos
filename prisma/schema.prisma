datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum TenantStatus {
  trialing
  active
  past_due
  suspended
  closed
}

enum UserRole {
  owner
  admin
  branch_manager
  warehouse_keeper
  accountant
  manager
  cashier
  auditor
}

enum MembershipStatus {
  invited
  active
  revoked
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
  paused
}

enum BillingInterval {
  monthly
  yearly
}

enum BillingProvider {
  paddle
  youcanpay
  hyperswitch
  manual
  mock
  lemonsqueezy
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
  disputed
}

enum ProductUnit {
  piece
  kg
  liter
  service
}

enum SaleStatus {
  draft
  completed
  voided
  refunded
  part_refunded
}

enum PaymentMethod {
  cash
  card
  transfer
  split
  credit
}

enum SalesChannel {
  pos
  online
  glovo
  jumia
}

enum InventoryMovementType {
  sale
  purchase
  return
  adjustment
  transfer_in
  transfer_out
  waste
}

enum InvoiceStatus {
  draft
  issued
  voided
  credited
}

enum InvoiceKind {
  invoice
  credit_note
  quote
}

enum PurchaseOrderStatus {
  draft
  sent
  ordered
  partially_received
  received
  canceled
}

enum StockTransferStatus {
  draft
  in_transit
  completed
  canceled
}

enum InvoiceScanStatus {
  pending
  processing
  completed
  failed
}

enum CustomerCreditType {
  charge
  payment
  adjustment
}

enum TableStatus {
  available
  occupied
  reserved
  billing
}

enum KitchenTicketStatus {
  new
  in_progress
  ready
  served
  canceled
}

enum KitchenItemStatus {
  pending
  preparing
  completed
  voided
}

enum LoyaltyReason {
  earn
  redeem
  refund
  adjustment
  expiry
}

enum DevicePlatform {
  pwa
  desktop
}

enum CashSessionStatus {
  open
  closed
}

enum SyncOpStatus {
  applied
  duplicate
  conflict
  rejected
}

enum WebhookEventStatus {
  received
  processed
  failed
  ignored
}

enum NotificationChannel {
  email
  push
  sms
  in_app
}

enum NotificationStatus {
  queued
  sent
  failed
  suppressed
}

enum ImportJobStatus {
  previewing
  ready
  committed
  failed
}

// ==========================================
// PHASE 1 — IDENTITY & TENANCY
// ==========================================

model Tenant {
  id                 String       @id @default(uuid()) @db.Uuid
  legalName          String       @map("legal_name")
  displayName        String       @map("display_name")
  slug               String       @unique
  ice                String?
  taxId              String?      @map("tax_id")
  rcNumber           String?      @map("rc_number")
  address            String?
  city               String?
  countryCode        String       @default("MA") @map("country_code") @db.Char(2)
  currency           String       @default("MAD") @db.Char(3)
  timezone           String       @default("Africa/Casablanca")
  locale             String       @default("ar")
  pricesIncludeTax   Boolean      @default(true) @map("prices_include_tax")
  allowNegativeStock Boolean      @default(true) @map("allow_negative_stock")
  restaurantMode     Boolean      @default(false) @map("restaurant_mode")
  status             TenantStatus @default(trialing)
  maxDevices         Int          @default(1) @map("max_devices")

  // Anti-Abuse & Cash Flow Protection Quotas (Pillar 4)
  aiMessagesUsedToday     Int       @default(0) @map("ai_messages_used_today")
  lastAiMessageDate       DateTime? @map("last_ai_message_date") @db.Date
  csvImportsUsedThisMonth Int       @default(0) @map("csv_imports_used_this_month")
  lastCsvImportMonth      String?   @map("last_csv_import_month") // format "YYYY-MM"

  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  memberships        TenantMembership[]
  invitations        Invitation[]
  stores             Store[]
  auditLogs          AuditLog[]
  idempotencyRecords IdempotencyRecord[]
  categories         Category[]
  taxRates           TaxRate[]
  products           Product[]
  devices            Device[]
  customers          Customer[]
  cashSessions       CashSession[]
  sales              Sale[]
  saleItems          SaleItem[]
  salePayments       SalePayment[]
  refunds            Refund[]
  inventoryMovements InventoryMovement[]
  stockLevels        StockLevel[]
  documentSequences  DocumentSequence[]
  invoiceSequences   InvoiceSequence[]
  productImportJobs  ProductImportJob[]
  subscriptions      Subscription[]
  payments           Payment[]
  invoices           Invoice[]
  loyaltyPoints      LoyaltyPoint[]
  syncOperations     SyncOperation[]
  syncConflicts      SyncConflict[]
  notifications      Notification[]
  suppliers          Supplier[]
  purchaseOrders     PurchaseOrder[]
  purchaseOrderItems PurchaseOrderItem[]
  customerCredits    CustomerCredit[]
  diningTables       DiningTable[]
  kitchenTickets     KitchenTicket[]
  kitchenTicketItems KitchenTicketItem[]
  aiChatSessions     AIChatSession[]
  stockTransfers     StockTransfer[]
  stockTransferItems StockTransferItem[]
  invoiceScanJobs    InvoiceScanJob[]
  zReports           ZReport[]
  stockPredictions   StockPrediction[]
  settings           TenantSettings?
  supportMessages    SupportMessage[]

  @@map("tenants")
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  name            String?
  fullName        String?   @map("full_name")
  email           String?   @unique
  emailVerified   DateTime? @map("email_verified") @db.Timestamptz(6)
  image           String?
  authProvider    String    @default("local") @map("auth_provider")
  providerSubject String?   @map("provider_subject")
  passwordHash    String?   @map("password_hash")
  phone           String?
  defaultTenantId String?   @map("default_tenant_id") @db.Uuid
  isSuperAdmin    Boolean   @default(false) @map("is_super_admin")
  isActive        Boolean   @default(true) @map("is_active")
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  accounts       Account[]
  sessions       Session[]
  memberships    TenantMembership[]
  auditLogs      AuditLog[]
  cashSessions   CashSession[]
  aiChatSessions AIChatSession[]

  @@map("users")
}

model Account {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String   @map("provider_account_id")
  refreshToken      String?  @map("refresh_token") @db.Text
  accessToken       String?  @map("access_token") @db.Text
  expiresAt         Int?     @map("expires_at")
  tokenType         String?  @map("token_type")
  scope             String?
  idToken           String?  @map("id_token") @db.Text
  sessionState      String?  @map("session_state")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id             String    @id @default(uuid()) @db.Uuid
  sessionToken   String    @unique @map("session_token")
  userId         String    @map("user_id") @db.Uuid
  expires        DateTime  @db.Timestamptz(6)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String?   @unique @map("token_hash")
  activeTenantId String?   @map("active_tenant_id") @db.Uuid
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(6)
  ip             String?
  userAgent      String?   @map("user_agent")
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime @db.Timestamptz(6)

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model TenantMembership {
  id                  String           @id @default(uuid()) @db.Uuid
  tenantId            String           @map("tenant_id") @db.Uuid
  tenant              Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId              String           @map("user_id") @db.Uuid
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role                UserRole
  permissionsOverride Json?            @map("permissions_override")
  storeIds            String[]         @default([]) @map("store_ids")
  status              MembershipStatus @default(active)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("tenant_memberships")
}

model Invitation {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email      String
  role       UserRole
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(6)
  invitedBy  String?   @map("invited_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId])
  @@map("invitations")
}

model Store {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      String
  name      String
  address   String?
  phone     String?
  timezone  String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  devices            Device[]
  sales              Sale[]
  cashSessions       CashSession[]
  stockLevels        StockLevel[]
  inventoryMovements InventoryMovement[]
  invoices           Invoice[]
  purchaseOrders     PurchaseOrder[]
  diningTables       DiningTable[]
  kitchenTickets     KitchenTicket[]
  transfersSent      StockTransfer[]     @relation("TransfersSent")
  transfersReceived  StockTransfer[]     @relation("TransfersReceived")
  zReports           ZReport[]
  stockPredictions   StockPrediction[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("stores")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorUser   User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id") @db.Uuid
  beforeState Json?    @map("before_state")
  afterState  Json?    @map("after_state")
  reason      String?
  ip          String?
  deviceId    String?  @map("device_id") @db.Uuid
  requestId   String?  @map("request_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

model IdempotencyRecord {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key            String
  scope          String
  requestHash    String   @map("request_hash")
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)

  @@unique([tenantId, scope, key])
  @@index([tenantId, expiresAt])
  @@map("idempotency_records")
}

// ==========================================
// PHASE 2 — CATALOG, INVENTORY, POS & CUSTOMERS
// ==========================================

model Category {
  id        String     @id @default(uuid()) @db.Uuid
  tenantId  String     @map("tenant_id") @db.Uuid
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentId  String?    @map("parent_id") @db.Uuid
  parent    Category?  @relation("CategoryHierarchy", fields: [tenantId, parentId], references: [tenantId, id], onDelete: Restrict)
  children  Category[] @relation("CategoryHierarchy")
  name      String
  sortOrder Int        @default(0) @map("sort_order")
  isActive  Boolean    @default(true) @map("is_active")
  serverSeq BigInt     @default(0) @map("server_seq")
  deletedAt DateTime?  @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  products Product[]

  @@unique([tenantId, id])
  @@index([tenantId, parentId])
  @@index([tenantId, serverSeq])
  @@map("categories")
}

model TaxRate {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      String
  label     String
  rate      Decimal  @db.Decimal(5, 2)
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("tax_rates")
}

model Product {
  id                String      @id @default(uuid()) @db.Uuid
  tenantId          String      @map("tenant_id") @db.Uuid
  tenant            Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId        String?     @map("category_id") @db.Uuid
  category          Category?   @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict)
  supplierId        String?     @map("supplier_id") @db.Uuid
  supplier          Supplier?   @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict)
  sku               String
  barcode           String?
  name              String
  description       String?
  imageUrl          String?     @map("image_url")
  unit              ProductUnit @default(piece)
  salePrice         Decimal     @map("sale_price") @db.Decimal(12, 2)
  wholesalePrice    Decimal?    @map("wholesale_price") @db.Decimal(12, 2)
  costPrice         Decimal?    @map("cost_price") @db.Decimal(12, 2)
  taxCode           String?     @map("tax_code")
  taxRate           Decimal     @default(20.00) @map("tax_rate") @db.Decimal(5, 2)
  trackStock        Boolean     @default(true) @map("track_stock")
  isActive          Boolean     @default(true) @map("is_active")
  lowStockThreshold Decimal?    @map("low_stock_threshold") @db.Decimal(12, 3)
  expiryDate        DateTime?   @map("expiry_date") @db.Date
  batchNumber       String?     @map("batch_number")
  version           BigInt      @default(1)
  serverSeq         BigInt      @default(0) @map("server_seq")
  deletedAt         DateTime?   @map("deleted_at") @db.Timestamptz(6)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  saleItems          SaleItem[]
  inventoryMovements InventoryMovement[]
  stockLevels        StockLevel[]
  purchaseOrderItems PurchaseOrderItem[]
  kitchenTicketItems KitchenTicketItem[]
  stockTransferItems StockTransferItem[]
  stockPredictions   StockPrediction[]

  @@unique([tenantId, id])
  @@unique([tenantId, sku])
  @@index([tenantId, barcode])
  @@index([tenantId, serverSeq])
  @@index([tenantId, categoryId])
  @@index([tenantId, supplierId])
  @@map("products")
}

model Device {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storeId        String         @map("store_id") @db.Uuid
  store          Store          @relation(fields: [tenantId, storeId], references: [tenantId, id], onDelete: Restrict)
  deviceCode     String         @map("device_code")
  name           String
  platform       DevicePlatform @default(pwa)
  tokenHash      String         @unique @map("token_hash")
  appVersion     String?        @map("app_version")
  nextReceiptSeq BigInt         @default(1) @map("next_receipt_seq")
  lastSyncAt     DateTime?      @map("last_sync_at") @db.Timestamptz(6)
  revokedAt      DateTime?      @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  sales          Sale[]
  cashSessions   CashSession[]
  syncOperations SyncOperation[]

  @@unique([tenantId, id])
  @@unique([tenantId, storeId, deviceCode])
  @@index([tenantId, storeId])
  @@map("devices")
}

model Customer {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                 String
  phone                String?
  normalizedPhone      String?   @map("normalized_phone")
  email                String?
  taxIdentifier        String?   @map("tax_identifier")
  ice                  String?
  address              String?
  marketingConsent     Boolean   @default(false) @map("marketing_consent")
  whatsappConsent      Boolean   @default(false) @map("whatsapp_consent")
  whatsappPhone        String?   @map("whatsapp_phone")
  consentAt            DateTime? @map("consent_at") @db.Timestamptz(6)
  consentSource        String?   @map("consent_source")
  currentCreditBalance Decimal   @default(0.00) @map("current_credit_balance") @db.Decimal(12, 2)
  creditLimit          Decimal?  @map("credit_limit") @db.Decimal(12, 2)
  serverSeq            BigInt    @default(0) @map("server_seq")
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  sales         Sale[]
  invoices      Invoice[]
  loyaltyPoints LoyaltyPoint[]
  credits       CustomerCredit[]

  @@unique([tenantId, id])
  @@index([tenantId, normalizedPhone])
  @@index([tenantId, serverSeq])
  @@map("customers")
}

model CashSession {
  id           String            @id @default(uuid()) @db.Uuid
  tenantId     String            @map("tenant_id") @db.Uuid
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storeId      String            @map("store_id") @db.Uuid
  store        Store             @relation(fields: [tenantId, storeId], references: [tenantId, id], onDelete: Restrict)
  deviceId     String?           @map("device_id") @db.Uuid
  device       Device?           @relation(fields: [tenantId, deviceId], references: [tenantId, id], onDelete: Restrict)
  userId       String            @map("user_id") @db.Uuid
  user         User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  openingCash  Decimal           @map("opening_cash") @db.Decimal(12, 2)
  expectedCash Decimal?          @map("expected_cash") @db.Decimal(12, 2)
  countedCash  Decimal?          @map("counted_cash") @db.Decimal(12, 2)
  discrepancy  Decimal?          @db.Decimal(12, 2)
  status       CashSessionStatus @default(open)
  zReport      Json?             @map("z_report")
  openedAt     DateTime          @default(now()) @map("opened_at") @db.Timestamptz(6)
  closedAt     DateTime?         @map("closed_at") @db.Timestamptz(6)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  sales Sale[]

  @@unique([tenantId, id])
  @@index([tenantId, storeId, status])
  @@map("cash_sessions")
}

model Sale {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storeId          String        @map("store_id") @db.Uuid
  store            Store         @relation(fields: [tenantId, storeId], references: [tenantId, id], onDelete: Restrict)
  deviceId         String?       @map("device_id") @db.Uuid
  device           Device?       @relation(fields: [tenantId, deviceId], references: [tenantId, id], onDelete: Restrict)
  cashSessionId    String?       @map("cash_session_id") @db.Uuid
  cashSession      CashSession?  @relation(fields: [tenantId, cashSessionId], references: [tenantId, id], onDelete: Restrict)
  cashierUserId    String        @map("cashier_user_id") @db.Uuid
  customerId       String?       @map("customer_id") @db.Uuid
  customer         Customer?     @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  tableId          String?       @map("table_id") @db.Uuid
  table            DiningTable?  @relation(fields: [tenantId, tableId], references: [tenantId, id], onDelete: Restrict)
  clientSaleId     String        @map("client_sale_id") @db.Uuid
  idempotencyKey   String        @map("idempotency_key")
  receiptNumber    String        @map("receipt_number")
  status           SaleStatus    @default(completed)
  subtotal         Decimal       @db.Decimal(12, 2)
  discountTotal    Decimal       @default(0.00) @map("discount_total") @db.Decimal(12, 2)
  taxTotal         Decimal       @map("tax_total") @db.Decimal(12, 2)
  grandTotal       Decimal       @map("grand_total") @db.Decimal(12, 2)
  paidTotal        Decimal       @map("paid_total") @db.Decimal(12, 2)
  changeDue        Decimal       @default(0.00) @map("change_due") @db.Decimal(12, 2)
  paymentMethod    PaymentMethod @default(cash) @map("payment_method")
  channel          SalesChannel  @default(pos)
  isTraining       Boolean       @default(false) @map("is_training")
  offlineCreatedAt DateTime?     @map("offline_created_at") @db.Timestamptz(6)
  completedAt      DateTime?     @map("completed_at") @db.Timestamptz(6)
  voidedAt         DateTime?     @map("voided_at") @db.Timestamptz(6)
  voidReason       String?       @map("void_reason")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  items           SaleItem[]
  payments        SalePayment[]
  refunds         Refund[]
  invoices        Invoice[]
