# ==============================================================================
# KASPI POS (كسب) — MASTER ENTERPRISE ENVIRONMENT CONFIGURATION (.env.example)
# Infinite Free-Tier Architecture: Vercel + Oracle ARM + Neon + Upstash + R2
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (Supavisor / Neon Serverless PostgreSQL)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.eu-central-1.neon.tech/neondb?sslmode=require"
DATABASE_URL_TEST="postgresql://user:password@localhost:5432/neondb_test"

# ------------------------------------------------------------------------------
# 2. Authentication & Core App Settings
# ------------------------------------------------------------------------------
NEXTAUTH_SECRET="generate-a-secure-random-32-byte-hex-string"
NEXTAUTH_URL="https://your-domain.com"
APP_SECRET="generate-a-second-random-32-byte-secret"
NEXT_PUBLIC_APP_URL="https://your-domain.com"
NODE_ENV="production"

# ------------------------------------------------------------------------------
# 3. Redis Rate Limiting & Caching (Upstash Free Tier - 10,000 req/day free)
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ------------------------------------------------------------------------------
# 4. Multi-Gateway AI Key Pool (Automatic Failover & Free-Tier Rotation)
# (Keys can be comma-separated pools e.g. key1,key2,key3 for multiplied limits)
# ------------------------------------------------------------------------------
GOOGLE_GENERATIVE_AI_API_KEY=""
GOOGLE_API_KEYS=""
GROQ_API_KEY=""
GROQ_API_KEYS=""
MISTRAL_API_KEY=""
MISTRAL_API_KEYS=""
TOGETHER_API_KEY=""
TOGETHER_API_KEYS=""
DEEPSEEK_API_KEY=""
HUGGINGFACE_API_KEY=""
OPENROUTER_API_KEY=""

# Optional Local AI fallback (Ollama / vLLM on local GPU server - 100% free offline)
LOCAL_AI_BASE_URL=""
LOCAL_AI_MODEL="llama3.2"

# ------------------------------------------------------------------------------
# 5. Background Jobs (Trigger.dev Cloud Free Tier or Self-Hosted Docker)
# ------------------------------------------------------------------------------
TRIGGER_API_URL="https://api.trigger.dev"
TRIGGER_SECRET_KEY=""
TRIGGER_PROJECT_ID=""

# ------------------------------------------------------------------------------
# 6. Payments (Hyperswitch / YouCanPay Morocco / Paddle Global)
