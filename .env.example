# ==============================================================================
# KASPI POS (كسب) — ENTERPRISE FREE-TIER ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# 1. Database & Authentication (PostgreSQL 16 + NextAuth v5 — Pooled + Direct URLs)
DATABASE_URL="postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_TEST="postgresql://pos_user:pos_password@localhost:5432/pos_saas_test?schema=public"
NEXTAUTH_SECRET="super-secret-at-least-32-chars-long-development-key"
NEXTAUTH_URL="http://localhost:3001"
APP_SECRET="super-secret-at-least-32-chars-long-development-key"
NEXT_PUBLIC_APP_URL="http://localhost:3001"
NODE_ENV="development"

# 2. Multi-Gateway AI Router (Zero-Downtime Free Tier Key Pool)
GOOGLE_GENERATIVE_AI_API_KEY=""
GOOGLE_API_KEYS=""
GROQ_API_KEY=""
GROQ_API_KEYS=""
OPENROUTER_API_KEY=""

# 3. Dual-Gateway Billing (Paddle International MoR + YouCan Pay Morocco)
PADDLE_API_KEY=""
PADDLE_WEBHOOK_SECRET=""
YOUCANPAY_PRIVATE_KEY=""
YOUCANPAY_PUBLIC_KEY=""

# 4. WhatsApp Business Gateway (Receipts, Z-Reports & Super Admin Alerts)
WHATSAPP_API_PROVIDER="ultramsg"
WHATSAPP_API_TOKEN=""
WHATSAPP_INSTANCE_ID=""
ADMIN_WHATSAPP_NUMBER="+212687597267"

# 5. Cloud Object Storage (Cloudflare R2 Free Tier - 10GB/month)
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="kaspi-pos-assets"
R2_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"

# 6. Upstash QStash (Asynchronous Background Jobs)
QSTASH_URL="https://qstash.upstash.io"
QSTASH_TOKEN="your_qstash_token"
QSTASH_CURRENT_SIGNING_KEY="your_current_signing_key"
QSTASH_NEXT_SIGNING_KEY="your_next_signing_key"
APP_URL="https://kaspi-pos.vercel.app"
