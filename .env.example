PADDLE_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# 7. Cloud Storage & Supabase Integration (Product Storage & KDS Realtime)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://tqoqsgaymygmgqrzddvtu.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_jxn-4TT28_G7LtZG4FJXTQ_75JiaSBi"
