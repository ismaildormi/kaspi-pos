# ==============================================================================
# KASPI POS (كسب) — MASTER ENTERPRISE ENVIRONMENT CONFIGURATION (.env.example)
# Hybrid Stack: Vercel (Edge) + Oracle Cloud VPS (Docker) + Neon (PostgreSQL)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database & Connection Pooling (Supavisor VPS Pooler + Neon Direct URL)
# ------------------------------------------------------------------------------
# Pooled connection string routed through Supavisor (Port 6543) or Neon PgBouncer
DATABASE_URL="postgresql://neondb_owner:your_password@supavisor.your-vps-domain.com:6543/neondb?sslmode=require&pgbouncer=true&connection_limit=1"
# Direct connection string to Neon PostgreSQL (Port 5432) for Prisma Migrations & DDL
DIRECT_URL="postgresql://neondb_owner:your_password@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_TEST="postgresql://pos_user:pos_password@localhost:5432/pos_saas_test?schema=public"

# ------------------------------------------------------------------------------
# 2. Authentication & Application Security (NextAuth.js v5 / Auth.js)
# ------------------------------------------------------------------------------
NEXTAUTH_SECRET="super-secret-at-least-32-chars-long-production-key"
NEXTAUTH_URL="https://kaspi-pos.vercel.app"
APP_SECRET="super-secret-at-least-32-chars-long-production-key"
NEXT_PUBLIC_APP_URL="https://kaspi-pos.vercel.app"
NODE_ENV="production"

# ------------------------------------------------------------------------------
# 3. Background Jobs & Queues (Trigger.dev v3 — Oracle Cloud VPS / Cloud)
# ------------------------------------------------------------------------------
TRIGGER_API_URL="https://trigger.your-vps-domain.com"
TRIGGER_SECRET_KEY="tr_prod_your_secret_key"
TRIGGER_API_KEY="tr_prod_your_api_key"
TRIGGER_PROJECT_ID="proj_kaspi_pos"

# ------------------------------------------------------------------------------
# 4. Payment Orchestration (Hyperswitch VPS + Paddle + YouCanPay Morocco)
# ------------------------------------------------------------------------------
HYPERSWITCH_API_URL="https://hyperswitch.your-vps-domain.com"
HYPERSWITCH_API_KEY="snd_your_hyperswitch_api_key"
HYPERSWITCH_PUBLISHABLE_KEY="pk_snd_your_hyperswitch_publishable_key"
HYPERSWITCH_PROFILE_ID="pro_your_hyperswitch_profile_id"
HYPERSWITCH_WEBHOOK_SECRET="whsec_your_hyperswitch_webhook_secret"

# Underlying Payment Processors orchestrated by Hyperswitch (or direct fallback)
PADDLE_API_KEY="pdl_live_apikey_your_paddle_key"
PADDLE_WEBHOOK_SECRET="pdl_ntfset_your_paddle_webhook_secret"
YOUCANPAY_API_KEY="ycp_live_your_youcanpay_api_key"
YOUCANPAY_PRIVATE_KEY="pri_your_youcanpay_private_key"
YOUCANPAY_PUBLIC_KEY="pub_your_youcanpay_public_key"

# ------------------------------------------------------------------------------
# 5. Multi-Gateway AI Router (Gemini 2.5 Flash + Groq Llama-3 + OpenRouter)
# ------------------------------------------------------------------------------
GOOGLE_GENERATIVE_AI_API_KEY="AIzaSy_your_gemini_api_key"
GOOGLE_API_KEYS="AIzaSy_key_1,AIzaSy_key_2"
GROQ_API_KEY="gsk_your_groq_api_key"
GROQ_API_KEYS="gsk_key_1,gsk_key_2"
OPENROUTER_API_KEY="sk-or-v1-your_openrouter_key"

# ------------------------------------------------------------------------------
# 6. Cloud Object Storage & Desktop Distribution (Cloudflare R2 Free Tier)
# ------------------------------------------------------------------------------
R2_ACCESS_KEY_ID="your_cloudflare_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_cloudflare_r2_secret_access_key"
R2_BUCKET_NAME="kaspi-pos-assets"
R2_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
NEXT_PUBLIC_R2_PUBLIC_URL="https://assets.kaspi-pos.com"

# ------------------------------------------------------------------------------
# 7. WhatsApp Business Gateway (Receipts, Daily Z-Reports & Super Admin Alerts)
# ------------------------------------------------------------------------------
WHATSAPP_API_PROVIDER="ultramsg"
WHATSAPP_API_TOKEN="your_ultramsg_token"
WHATSAPP_INSTANCE_ID="instance_your_id"
ADMIN_WHATSAPP_NUMBER="+212687597267"
