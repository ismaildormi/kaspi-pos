# ==============================================================================
# KASPI POS — VPS secrets (copy to deploy/.env — NEVER commit the real file)
# Generate secrets with:  openssl rand -hex 32
# ==============================================================================

# Public hostnames (create DNS A records pointing to the VPS public IP)
TRIGGER_DOMAIN="trigger.your-domain.com"
HYPERSWITCH_DOMAIN="pay.your-domain.com"
ACME_EMAIL="admin@your-domain.com"

# Local metadata Postgres (VPS only)
VPS_PG_USER="kaspi"
VPS_PG_PASSWORD="change_me_openssl_rand_hex_32"

# Supavisor
SUPAVISOR_SECRET_KEY_BASE="change_me_64_chars_openssl_rand_hex_32"
SUPAVISOR_VAULT_ENC_KEY="change_me_exactly_32_characters!"
SUPAVISOR_API_JWT_SECRET="change_me_openssl_rand_hex_32"
SUPAVISOR_RELEASE_COOKIE="change_me_openssl_rand_hex_16"
SUPAVISOR_TENANT_ID="kaspi"
# Neon DIRECT (non-pooler) host that Supavisor connects to
NEON_HOST="ep-jolly-snow-b9x9fbox.c-7.eu-central-1.aws.neon.tech"
NEON_DB="neondb"
NEON_USER="neondb_owner"
NEON_PASSWORD="your_neon_password"
SUPAVISOR_POOL_SIZE="20"

# Trigger.dev
TRIGGER_IMAGE_TAG="v4.0.0"
TRIGGER_ADMIN_EMAIL="you@your-domain.com"
TRIGGER_SESSION_SECRET="change_me_openssl_rand_hex_16"
TRIGGER_MAGIC_LINK_SECRET="change_me_openssl_rand_hex_16"
TRIGGER_ENCRYPTION_KEY="change_me_openssl_rand_hex_16"
TRIGGER_MANAGED_WORKER_SECRET="change_me_openssl_rand_hex_16"
TRIGGER_EMAIL_TRANSPORT=""
TRIGGER_FROM_EMAIL=""
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""

# Hyperswitch
HYPERSWITCH_IMAGE_TAG="standalone"
HYPERSWITCH_RUN_ENV="sandbox"
HYPERSWITCH_ADMIN_API_KEY="change_me_openssl_rand_hex_32"
HYPERSWITCH_MASTER_ENC_KEY="change_me_64_hex_chars_openssl_rand_hex_32"
HYPERSWITCH_JWT_SECRET="change_me_openssl_rand_hex_32"
