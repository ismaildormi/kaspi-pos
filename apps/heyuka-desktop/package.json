{
  "name": "@kaspi/heyuka-desktop",
  "version": "10.0.0",
  "private": true,
  "description": "HEYUKA Desktop OS by KASPI — 60 FPS WebGL2/GPGPU Companion, Ghost Cursor OS Automation, Adobe/Blender Bridges, TripoSR & Python Swarm.",
  "author": "KASPI",
  "main": "electron/main.cjs",
  "scripts": {
    "electron:start": "electron .",
    "package:win": "electron-builder --win nsis portable appx",
    "package:mac": "electron-builder --mac dmg zip",
    "package:linux": "electron-builder --linux AppImage flatpak snap"
  },
  "build": {
    "appId": "com.kaspi.heyuka.desktop",
    "productName": "HEYUKA Desktop OS (by KASPI)",
    "win": {
      "target": ["nsis", "portable", "appx"]
    },
    "mac": {
      "target": ["dmg", "zip"]
    },
    "linux": {
      "target": ["AppImage", "flatpak", "snap"]
    }
  }
}
