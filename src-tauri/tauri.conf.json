{
  "$schema": "https://schema.tauri.app/v2",
  "productName": "Kasbi POS",
  "version": "0.1.0",
  "identifier": "ma.kasbi.pos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3001",
    "beforeBuildCommand": "",
    "frontendDist": "https://kaspi-pos.vercel.app"
  },
  "app": {
    "windows": [
      {
        "title": "Kasbi POS — نظام كسب لنقاط البيع للمغرب",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
